# Trim the build context for the webui image (compose build context = repo root).
# Keep exactly what the image copies:
#   visionist_client/{pyproject.toml,README.md,LICENSE,src}
#   webui/{pyproject.toml,README.md,src,boxes,web/dist}

# VCS + local artifacts
.git/
*.whl
*.mp4
*.log

# Python junk
**/__pycache__/
**/*.pyc
**/*.egg-info/
.venv/
fleet/.venv/
.venv-decode/
.venv-nb/

# webui: only the PREBUILT SPA + package are needed (skip build sources & state)
webui/web/node_modules/
webui/web/src/
webui/web/*.map
webui/web/package-lock.json
webui/tests/
webui/data/
webui/data-docker/

# visionist_client build artifacts
visionist_client/build/
visionist_client/dist/
visionist_client/tests/

# large / unrelated to the webui image
images/
fleet/
docs/
notebooks/
protos/
